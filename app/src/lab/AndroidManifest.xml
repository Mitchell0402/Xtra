<?xml version="1.0" encoding="utf-8"?>
<!-- U0 lab screens and the U1 component showcase: only in debug and benchmark builds, never in qa or release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name="com.github.andreyasadchy.xtra.lab.LabActivity"
            android:exported="true"
            android:label="Lagoon lab"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.github.andreyasadchy.xtra.lab.ChatLabActivity"
            android:exported="true"
            android:label="Chat lab" />

        <activity
            android:name="com.github.andreyasadchy.xtra.lab.PlayerSwitchLabActivity"
            android:exported="true"
            android:label="Player switch lab" />

        <!-- U1 component showcase (plan section 6), with its own launcher icon in debug builds -->
        <activity
            android:name="com.github.andreyasadchy.xtra.lab.showcase.ComponentShowcaseActivity"
            android:exported="true"
            android:label="Lagoon 组件"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stage G: Following with fixed data, the pill in its own root as in the shell; GlassBenchmark scrolls it -->
        <activity
            android:name="com.github.andreyasadchy.xtra.lab.glass.GlassLabActivity"
            android:exported="true"
            android:label="Glass lab"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- stage G: lets a launch extra force glass on or off (benchmark A/B); not in qa or release -->
        <provider
            android:name="com.github.andreyasadchy.xtra.lab.glass.LabGlassInit"
            android:authorities="${applicationId}.labglass"
            android:exported="false" />

    </application>
</manifest>
