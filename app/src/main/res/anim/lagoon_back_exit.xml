<?xml version="1.0" encoding="utf-8"?>
<!-- LagoonMotion.back() for activities: the page slides out to the end and fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:shareInterpolator="false">
    <translate android:interpolator="@interpolator/lagoon_standard" android:fromXDelta="0" android:toXDelta="100%p" />
    <alpha android:interpolator="@interpolator/lagoon_exit" android:fromAlpha="1" android:toAlpha="0" />
</set>
