<?xml version="1.0" encoding="utf-8"?>
<!-- LagoonMotion.forward() for activities: the old page shrinks to 96 % and dims to 40 %. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:shareInterpolator="false">
    <scale android:interpolator="@interpolator/lagoon_standard"
        android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:interpolator="@interpolator/lagoon_exit" android:fromAlpha="1" android:toAlpha="0.4" />
</set>
