<?xml version="1.0" encoding="utf-8"?>
<!-- Going back (plan 5): the previous page grows back from 96 % and brightens. Medium, 300 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@interpolator/lagoon_standard"
    android:shareInterpolator="true">
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" />
</set>
