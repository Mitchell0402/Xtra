<?xml version="1.0" encoding="utf-8"?>
<!-- Going one level deeper (plan 5): the old page shrinks a little and fades out. The fragment container draws the
     leaving page on top, so it fades all the way to reveal the new page under it. Medium, 300 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@interpolator/lagoon_exit"
    android:shareInterpolator="true">
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
