<?xml version="1.0" encoding="utf-8"?>
<!-- Switching between tabs (plan 5): the old tab fades out while shifting the other way. Short, 200 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:interpolator="@interpolator/lagoon_exit"
    android:shareInterpolator="true">
    <translate android:fromXDelta="0" android:toXDelta="6%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
