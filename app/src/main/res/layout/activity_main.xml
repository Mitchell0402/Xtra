<?xml version="1.0" encoding="utf-8"?>
<!-- The Lagoon window (plan 7.1 and 8, U8): one ComposeView draws the navigation and every page (MainShell); the
     player's fragment container stays a view above it, so the player restores and enters picture-in-picture as before. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:focusable="true" />

</FrameLayout>
