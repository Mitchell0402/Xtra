<?xml version="1.0" encoding="utf-8"?>
<!-- Lagoon is dark only (plan section 4). Screens draw themselves in Compose (ui/design/theme); this window theme only
     sets what shows before the first frame and what the remaining platform pieces read (the sleep timer's time picker,
     dialogs, web views). The light, AMOLED, blue, compact and corner variants were deleted in U8. -->
<resources>

    <style name="BaseDarkTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lagoonAccent</item>
        <item name="colorOnPrimary">@color/lagoonOnAccent</item>
        <item name="android:colorBackground">@color/lagoonPage</item>
        <item name="android:windowBackground">@color/lagoonPage</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="DarkTheme" parent="BaseDarkTheme" />

</resources>
